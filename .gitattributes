# 统一行尾：源码全部用 LF，避免 Windows / Linux 协作时产生整文件 diff
* text=auto eol=lf

# 二进制文件不做行尾转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.docx binary
*.xlsx binary
*.pptx binary
*.exe  binary

# Windows 专有文本文件保留 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.sln  text eol=crlf
*.vcxproj     text eol=crlf
*.vcxproj.filters text eol=crlf

# 便于 diff 与语言统计
*.md   text
*.cpp  text
*.h    text
*.txt  text
